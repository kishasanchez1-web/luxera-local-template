<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LUXERA | Effortless Stewardship for Home, Capital & Legacy</title>
  <link rel="preconnect" href="https://googleapis.com">
  <link href="https://googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #FAF8F5;
      --bg-alt: #F3EFE8;
      --text: #1C1B18;
      --muted: #5A564E;
      --gold: #B39968;
      --border: #E2DDD2;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Cormorant Garamond', Georgia, serif;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }
    .sans { font-family: 'Inter', sans-serif; }
    .eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 14px;
    }
    header {
      border-bottom: 1px solid var(--gold);
      padding: 22px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      background: rgba(250, 248, 245, 0.96);
      z-index: 50;
    }
    .logo {
      font-size: 22px;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--text);
    }
    nav a {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--muted);
      margin-left: 24px;
    }
    nav a:hover { color: var(--gold); }
    .container { max-width: 1140px; margin: 0 auto; padding: 0 24px; }
    .hero {
      text-align: center;
      padding: 110px 24px 96px;
      border-bottom: 1px solid var(--gold);
    }
    .hero h1 {
      font-size: clamp(36px, 5vw, 58px);
      font-weight: 400;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      line-height: 1.18;
      margin-bottom: 22px;
    }
    .hero p {
      max-width: 620px;
      margin: 0 auto 38px;
      font-size: 20px;
      color: var(--muted);
    }
    .btn {
      display: inline-block;
      padding: 15px 34px;
      border: 1px solid var(--gold);
      background: transparent;
      color: var(--text);
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.25s ease;
    }
    .btn:hover, .btn-solid {
      background: var(--text);
      color: var(--bg);
      border-color: var(--text);
    }
    .btn-solid:hover {
      background: var(--gold);
      border-color: var(--gold);
      color: #fff;
    }
    .section { padding: 88px 0; border-bottom: 1px solid var(--gold); }
    .section-title { text-align: center; margin-bottom: 56px; }
    .section-title h2 {
      font-size: 34px;
      font-weight: 400;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 28px;
    }
    .card {
      border: 1px solid var(--gold);
      padding: 36px 30px;
      background: var(--bg);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .card h3 {
      font-size: 22px;
      font-weight: 400;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    .price {
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      letter-spacing: 0.18em;
      color: var(--gold);
      text-transform: uppercase;
      margin-bottom: 16px;
    }
    .card p { font-size: 17px; color: var(--muted); margin-bottom: 26px; }
    table { width: 100%; border-collapse: collapse; font-size: 15px; border: 1px solid var(--gold); }
    th, td { padding: 18px 20px; border-bottom: 1px solid var(--border); text-align: left; }
    th {
      background: var(--bg-alt);
      font-family: 'Inter', sans-serif;
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }
    .academy-box {
      background: var(--bg-alt);
      border: 1px solid var(--gold);
      padding: 60px 40px;
      text-align: center;
    }
    .modal-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(28, 27, 24, 0.65);
      z-index: 100;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .modal {
      background: var(--bg);
      border: 1px solid var(--gold);
      max-width: 540px;
      width: 100%;
      padding: 40px;
      position: relative;
      max-height: 90vh;
      overflow-y: auto;
    }
    .modal input, .modal textarea {
      width: 100%;
      padding: 12px 14px;
      margin-bottom: 16px;
      border: 1px solid var(--gold);
      background: #fff;
      font-family: 'Inter', sans-serif;
      font-size: 13px;
      color: var(--text);
    }
    .close-btn {
      position: absolute;
      top: 16px;
      right: 20px;
      background: none;
      border: none;
      font-size: 22px;
      cursor: pointer;
      color: var(--muted);
    }
    footer {
      text-align: center;
      padding: 48px 24px;
      font-family: 'Inter', sans-serif;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--muted);
    }
    @media (max-width: 768px) {
      header { flex-direction: column; gap: 14px; padding: 18px; }
      nav a { margin: 0 8px; }
    }
  </style>
</head>
<body>

