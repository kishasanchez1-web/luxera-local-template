              "id": "msg-es-subj",
              "name": "email_subject",
              "value": "Bienvenido a Luxera — Hemos recibido su solicitud",
              "type": "string"
            },
            {
              "id": "msg-es-body",
              "name": "email_body",
              "value": "=Hola {{ $json.body.client_name }},\n\nGracias por comunicarse con Luxera. Nuestro equipo ha recibido su información y se pondrá en contacto con usted a la brevedad.\n\nCon gratitud,\nEquipo Luxera",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-template-es",
      "name": "Format Spanish Alert",
      "type": "n8n-nodes-base.set",
