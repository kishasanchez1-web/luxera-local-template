    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "msg-en-subj",
              "name": "email_subject",
              "value": "Welcome to Luxera — We Have Received Your Inquiry",
              "type": "string"
            },
            {
              "id": "msg-en-body",
              "name": "email_body",
              "value": "=Hello {{ $json.body.client_name }},\n\nThank you for connecting with Luxera. Our team has received your details and will follow up with you shortly.\n\nWith gratitude,\nThe Luxera Team",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-template-en",
      "name": "Format English Alert",
      "type": "n8n-nodes-base.set",
