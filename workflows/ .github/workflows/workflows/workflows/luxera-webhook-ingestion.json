{
  "name": "Luxera - Webhook Ingestion & Lookup",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "luxera-lead-ingest",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "node-webhook-ingest",
      "name": "Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position":,
      "webhookId": "luxera-lead-ingest"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "field-name",
              "name": "client_name",
              "value": "={{ $json.body.name || $json.body.full_name || 'Prospective Client' }}",
              "type": "string"
            },
            {
              "id": "field-email",
              "name": "client_email",
              "value": "={{ $json.body.email || '' }}",
              "type": "string"
            },
            {
              "id": "field-phone",
              "name": "client_phone",
              "value": "={{ $json.body.phone || '' }}",
              "type": "string"
            },
            {
              "id": "field-language",
              "name": "preferred_language",
              "value": "={{ $json.body.language || 'EN' }}",
              "type": "string"
            },
            {
              "id": "field-timestamp",
              "name": "received_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-normalize-lead",
      "name": "Normalize Lead Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-has-email",
              "leftValue": "={{ $json.client_email }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-validate-contact",
      "name": "Valid Contact Info?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_URL }}/webhook/luxera-client-alert",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "node-forward-alert",
      "name": "Trigger Client Alert Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 220]
    }
  ],
  "connections": {
    "Lead Webhook": {
      "main": [
        [
          {
            "node": "Normalize Lead Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Lead Data": {
      "main": [
        [
          {
            "node": "Valid Contact Info?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Valid Contact Info?": {
      "main": [
        [
          {
            "node": "Trigger Client Alert Agent",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null
}
