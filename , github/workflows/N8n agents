name: Deploy Luxera Agents to n8n Droplet

on:
  push:
    branches: [ main ]
    paths: [ 'workflows/*.json' ]
  workflow_dispatch:

jobs:
  deploy-n8n-workflows:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Push and Activate Workflows in n8n
        env:
          N8N_URL: ${{ secrets.N8N_BASE_URL }}
          N8N_KEY: ${{ secrets.N8N_API_KEY }}
        run: |
          for file in workflows/*.json; do
            RESPONSE=$(curl -s -X POST "$N8N_URL/api/v1/workflows" \
              -H "X-N8N-API-KEY: $N8N_KEY" \
              -H "Content-Type: application/json" \
              -d @"$file")
            WORKFLOW_ID=$(echo "$RESPONSE" | jq -r '.id // empty')
            if [ -n "$WORKFLOW_ID" ]; then
              curl -s -X POST "$N8N_URL/api/v1/workflows/$WORKFLOW_ID/activate" -H "X-N8N-API-KEY: $N8N_KEY"
            fi
          done
