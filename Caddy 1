#!/bin/bash
set -e

echo "1. Starting n8n with Public API & Webhook URL enabled..."
docker start n8n 2>/dev/null || docker run -d --restart unless-stopped --name n8n -p 5678:5678 \
  -e N8N_SECURE_COOKIE=false \
  -e N8N_PUBLIC_API_DISABLED=false \
  -e WEBHOOK_URL=https://yourluxera.com \
  -v n8n_data:/home/node/.n8n docker.n8n.io/n8nio/n8n

echo "2. Installing Caddy HTTPS reverse proxy..."
apt-get update -y && apt-get install -y caddy curl jq

cat << 'CADDY' > /etc/caddy/Caddyfile
://yourluxera.com {
    reverse_proxy localhost:5678
}
CADDY

systemctl restart caddy

echo "------------------------------------------------------------"
echo "LUXERA SERVER ACTIVE!"
echo "Point DNS A-record '://yourluxera.com' to: $(curl -s ifconfig.me)"
echo "Then open https://://yourluxera.com -> Settings -> n8n API"
echo "------------------------------------------------------------"
